/ {
	model = "STM32 Minimum Development Board (Blue)";
	compatible = "stm32_min_dev_blue", "st,stm32f103c8";

	buttons {
		compatible = "gpio-keys";
		button: button {
			gpios = <&gpiob 0 GPIO_PULL_UP>;
			label = "BT";
		};
	};
	aliases {
     		button0 = &button;               // alias -> label
	};
};
