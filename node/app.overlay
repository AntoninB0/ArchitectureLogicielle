/* Bouton USER externe : PB0 relié à G par un bouton poussoir.
 * ACTIVE_LOW : appuyé = 0 V ; PULL_UP : résistance interne vers 3,3 V au repos. */
/ {
	buttons {
		compatible = "gpio-keys";
		button: button {
			gpios = <&gpiob 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "BT";
		};
	};

	aliases {
		button0 = &button;
	};
};

/* Lignes entre cartes : pull-up sur RX, pour qu'une ligne non câblée
 * (amont du maître, aval du dernier) reste au repos au lieu de capter du bruit. */
&usart2_rx_pa3 {
	bias-pull-up;
};

&usart3_rx_pb11 {
	bias-pull-up;
};
